author = {L.P. Clarke and R.P. Velthuizen and M.A. Camacho and J.J. Heine and M. Vaidyanathan and L.O. Hall and R.W. Thatcher and M.L. Silbiger},
keywords = {MRI segmentation, Image registration, Surgery simulation},
abstract = {The current literature on MRI segmentation methods is reviewed. Particular emphasis is placed on the relative merits of single image versus multispectral segmentation, and supervised versus unsupervised segmentation methods. Image pre-processing and registration are discussed, as well as methods of validation. The application of MRI segmentation for tumor volume measurements during the course of therapy is presented here as an example, illustrating problems associated with inter- and intra-observer variations inherent to supervised methods.}
}

